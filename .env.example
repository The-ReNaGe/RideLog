# ════════════════════════════════════════════════════════════════════════════
# RideLog — Configuration
# ════════════════════════════════════════════════════════════════════════════
#
# 1. Copiez ce fichier en .env :
#       cp .env.example .env
#
# 2. Remplissez les valeurs marquées ⚠️  (obligatoires en production)
#
# 3. Le fichier .env est dans .gitignore — il ne sera jamais commité
#    Ce fichier .env.example est lui versionné et doit rester avec des
#    valeurs d'exemple uniquement (jamais vos vraies clés)
#
# ════════════════════════════════════════════════════════════════════════════


# ── AUTHENTIFICATION & SÉCURITÉ ─────────────────────────────────────────────

# ⚠️  Clé secrète pour signer les tokens JWT — OBLIGATOIRE
# Le backend REFUSE DE DÉMARRER tant que cette ligne n'est pas remplacée :
# la valeur ci-dessous est publique, la laisser telle quelle permettrait à
# n'importe qui de forger un token administrateur.
# Toute modification invalide toutes les sessions actives (déconnexion de tous)
# Générer une clé forte :  openssl rand -hex 32
JWT_SECRET=changez-moi-en-production

# ⚠️  Clé secrète pour l'initialisation du compte Home Assistant
# Home Assistant doit fournir cette clé pour créer son compte d'intégration
# Peut être n'importe quelle chaîne — mais choisissez quelque chose de robuste
# Générer :  openssl rand -hex 16
HA_INIT_KEY=changez-moi-aussi


# ── INSCRIPTION ─────────────────────────────────────────────────────────────

# Mode d'inscription des nouveaux utilisateurs :
#   invite  → sur invitation uniquement — un admin génère un lien (recommandé)
#   open    → inscription libre, tout le monde peut créer un compte
#   closed  → fermé, seul un admin peut créer des comptes manuellement
REGISTRATION_MODE=invite


# ── LOGS & CORS ─────────────────────────────────────────────────────────────

# Niveau de log : DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Origines autorisées pour les requêtes CORS (séparées par des virgules)
# Laisser VIDE dans le déploiement standard : le site et l'API sont servis sur
# la même origine par nginx, aucun en-tête CORS n'est nécessaire. Home Assistant
# n'est pas concerné (appels serveur à serveur, le CORS ne vise que les
# navigateurs). Ne remplir que pour un front servi depuis une autre origine :
#   CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=


# ── EXPOSITION SUR INTERNET ─────────────────────────────────────────────────

# ⚠️ RideLog est servi en HTTP simple, sans chiffrement.
# N'exposez JAMAIS les ports directement sur Internet : mots de passe et
# tokens circuleraient en clair. Placez un reverse proxy avec certificat TLS
# (Caddy, Traefik, nginx proxy manager…) devant le port du service "frontend",
# et n'exposez PAS le port 8000 du backend.

# Proxys autorisés à déclarer l'IP réelle du visiteur (X-Forwarded-For /
# X-Real-IP). Accepte des IP, des blocs CIDR ou des noms d'hôte, séparés par
# des virgules. Vide = aucune confiance, seule l'adresse de la connexion
# compte.
#
# Le nginx fourni est déjà déclaré dans docker-compose.yml (TRUSTED_PROXIES=frontend).
# Si vous placez VOTRE PROPRE reverse proxy devant, ajoutez ici son adresse
# telle que la voit le conteneur, sinon tous vos visiteurs seront comptabilisés
# sous une seule et même IP — un seul attaquant verrouillerait alors le login
# pour tout le monde. Depuis l'hôte, c'est en général la passerelle Docker :
#   TRUSTED_PROXIES=frontend,172.18.0.1
#
# ⚠️ N'y mettez jamais un bloc large (172.16.0.0/12) si le port 8000 est
# accessible : l'IP deviendrait usurpable et le blocage anti-bruteforce
# contournable.
#TRUSTED_PROXIES=


# ── APIS OPTIONNELLES ───────────────────────────────────────────────────────

# Décodage de plaque d'immatriculation française (10 req/mois gratuit)
# Sans cette clé, le bouton "Décoder la plaque" sera désactivé
# Obtenir une clé : https://rapidapi.com/api-plaque-immatriculation-siv-api-plaque-immatriculation-siv-default/api/api-plaque-immatriculation-siv/
# Le décodage VIN utilise l'API NHTSA — gratuit, sans clé nécessaire
RAPIDAPI_KEY=


# ── RAPPELS / SCHEDULER ─────────────────────────────────────────────────────

# Intervalle de vérification des rappels en secondes
# 3600 = toutes les heures (recommandé)
REMINDER_INTERVAL=3600

# Activer ou désactiver le scheduler de rappels automatiques
REMINDER_ENABLED=true


# ── PORTS ────────────────────────────────────────────────────────────────────

# Port d'accès à l'interface web (défaut : 3100)
FRONTEND_PORT=3100

# Port d'accès à l'API backend (défaut : 8000)
BACKEND_PORT=8000